<Window x:Class="poradnik.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kolekcjoner"
        Height="760"
        Width="850"
        MinHeight="680"
        MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Background="#10151C">

    <Window.Resources>
        <Style x:Key="GameButton" TargetType="Button">
            <Setter Property="Background" Value="#C9A45C"/>
            <Setter Property="Foreground" Value="#10151C"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="GRA EKONOMICZNA"
                       Foreground="#C9A45C"
                       FontSize="12"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="KOLEKCJONER"
                       Foreground="#F5E6C8"
                       FontSize="30"
                       FontWeight="ExtraBold"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,12"/>

            <Border Background="#202A35"
                    CornerRadius="14"
                    Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="TWOJE PIENIĄDZE"
                                   Foreground="#AAB6C4"
                                   FontSize="11"/>
                        <TextBlock x:Name="MoneyBlock"
                                   Text="0 zł"
                                   Foreground="#F6C85F"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock Text="ZAROBEK"
                                   Foreground="#AAB6C4"
                                   FontSize="11"
                                   HorizontalAlignment="Right"/>
                        <TextBlock x:Name="IncomeBlock"
                                   Text="1 zł / klik"
                                   Foreground="#8EE3A1"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#202A35"
                CornerRadius="16"
                Padding="20"
                Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Zarabiaj pieniądze"
                           Foreground="#F5E6C8"
                           FontSize="21"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Kliknij przycisk, aby zdobyć pieniądze."
                           Foreground="#AAB6C4"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,16"/>

                <Button x:Name="WorkBtn"
                        Content="PRACUJ  +1 zł"
                        Height="60"
                        FontSize="19"
                        Style="{StaticResource GameButton}"
                        Click="WorkClick"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#202A35"
                    CornerRadius="10"
                    Padding="12"
                    Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="ZAROBEK PASYWNY"
                               Foreground="#AAB6C4"
                               FontSize="10"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="PassiveBlock"
                               Text="0 zł / sek."
                               Foreground="#8EE3A1"
                               FontSize="17"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="#202A35"
                    CornerRadius="10"
                    Padding="12"
                    Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="KUPIONE ULEPSZENIA"
                               Foreground="#AAB6C4"
                               FontSize="10"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LevelBlock"
                               Text="0"
                               Foreground="#F6C85F"
                               FontSize="17"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="3"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="ULEPSZENIA"
                           Foreground="#F5E6C8"
                           FontSize="19"
                           FontWeight="Bold"
                           Margin="0,4,0,10"/>

                <UniformGrid Columns="2">
                    <Border Background="#202A35"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,0,6,8">
                        <StackPanel>
                            <TextBlock Text="Lepsza praca"
                                       Foreground="#F5E6C8"
                                       FontSize="16"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Więcej pieniędzy za kliknięcie."
                                       Foreground="#AAB6C4"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,10"/>
                            <TextBlock x:Name="ClickLevelBlock"
                                       Text="Poziom: 0"
                                       Foreground="#8EE3A1"
                                       Margin="0,0,0,8"/>
                            <Button x:Name="ClickUpgradeBtn"
                                    Content="Kup: 25 zł"
                                    Style="{StaticResource GameButton}"
                                    Click="UpgradeClick"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#202A35"
                            CornerRadius="12"
                            Padding="14"
                            Margin="6,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Wydajność"
                                       Foreground="#F5E6C8"
                                       FontSize="16"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Znacznie zwiększa zarobek z pracy."
                                       Foreground="#AAB6C4"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,10"/>
                            <TextBlock x:Name="PowerLevelBlock"
                                       Text="Poziom: 0"
                                       Foreground="#8EE3A1"
                                       Margin="0,0,0,8"/>
                            <Button x:Name="PowerUpgradeBtn"
                                    Content="Kup: 100 zł"
                                    Style="{StaticResource GameButton}"
                                    Click="UpgradePower"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#202A35"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,0,6,8">
                        <StackPanel>
                            <TextBlock Text="Automatyczna praca"
                                       Foreground="#F5E6C8"
                                       FontSize="16"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Zarabiasz nawet bez klikania."
                                       Foreground="#AAB6C4"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,10"/>
                            <TextBlock x:Name="AutoLevelBlock"
                                       Text="Poziom: 0"
                                       Foreground="#8EE3A1"
                                       Margin="0,0,0,8"/>
                            <Button x:Name="AutoUpgradeBtn"
                                    Content="Kup: 150 zł"
                                    Style="{StaticResource GameButton}"
                                    Click="UpgradeAuto"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#202A35"
                            CornerRadius="12"
                            Padding="14"
                            Margin="6,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Rozwój firmy"
                                       Foreground="#F5E6C8"
                                       FontSize="16"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Zwiększa automatyczne dochody."
                                       Foreground="#AAB6C4"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,10"/>
                            <TextBlock x:Name="BusinessLevelBlock"
                                       Text="Poziom: 0"
                                       Foreground="#8EE3A1"
                                       Margin="0,0,0,8"/>
                            <Button x:Name="BusinessUpgradeBtn"
                                    Content="Kup: 300 zł"
                                    Style="{StaticResource GameButton}"
                                    Click="UpgradeBusiness"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="4"
                Background="#202A35"
                CornerRadius="10"
                Padding="10"
                Margin="0,8,0,0">
            <DockPanel>
                <TextBlock x:Name="MessageBlock"
                           Text="Zacznij zarabiać i rozwijaj swoją firmę."
                           Foreground="#F5E6C8"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,8,0"/>
                <Button Content="Reset"
                        DockPanel.Dock="Right"
                        Style="{StaticResource GameButton}"
                        Padding="14,8"
                        Click="ResetGame"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>